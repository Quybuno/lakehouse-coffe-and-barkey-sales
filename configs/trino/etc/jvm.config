-server
# Container cap 2048M trong docker-compose.yml → Xmx ~70% cap, chừa ~600M cho
# non-heap (metaspace, direct buffer, GC overhead, code cache). Nếu đổi cap
# container, nhớ chỉnh đồng bộ `-Xmx` + `query.max-memory*` trong config.properties.
-Xmx1400m
-XX:InitialRAMPercentage=70
-XX:MaxRAMPercentage=70
-XX:+UseG1GC
-XX:G1HeapRegionSize=32M
# Target pause thấp để healthcheck (timeout 10s) không fail khi GC nặng —
# tránh nguyên nhân chính khiến client báo "mất kết nối Trino".
-XX:MaxGCPauseMillis=200
-XX:+ExplicitGCInvokesConcurrent
-XX:+ExitOnOutOfMemoryError
-XX:+HeapDumpOnOutOfMemoryError
-XX:-OmitStackTraceInFastThrow
-XX:ReservedCodeCacheSize=512M
-XX:PerMethodRecompilationCutoff=10000
-XX:PerBytecodeRecompilationCutoff=10000
-Djdk.attach.allowAttachSelf=true
-Djdk.nio.maxCachedBufferSize=2000000
-Dfile.encoding=UTF-8
